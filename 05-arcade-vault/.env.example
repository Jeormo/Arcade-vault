# Copia este archivo a .env.local y rellena los valores.
# Solo servidor: nunca uses el prefijo NEXT_PUBLIC_ con estas variables.

# Clave de API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Destinatario de los mensajes de contacto (la bandeja del equipo).
# Con el remitente de pruebas de Resend, debe ser el correo de tu cuenta de Resend.
CONTACT_TO_EMAIL=

# Remitente. En pruebas: Arcade Vault <onboarding@resend.dev>
CONTACT_FROM_EMAIL=
